# ==============================================================================
# Multilingual Agritech & Resource Advisory Assistant - Environment Config
# ==============================================================================

# Google Gemini API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key (Free tier from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Mandi / Commodity Price API Key (Optional from data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# RAG & Embedding Settings
CHROMA_PERSIST_DIR=knowledge_base/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
COLLECTION_NAME=agritech_knowledge_base
